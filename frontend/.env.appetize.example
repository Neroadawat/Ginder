# Copy this file to .env.appetize and replace the host with the public HTTPS
# address of your backend tunnel or staging server. Never commit .env.appetize.
API_BASE_URL=https://YOUR-PUBLIC-HOST/api/v1
WS_BASE_URL=wss://YOUR-PUBLIC-HOST/ws
DEEP_LINK_PREFIX=ginder://
FCM_ENABLED=false
PRIVACY_POLICY_URL=https://YOUR-PUBLIC-HOST/privacy
TERMS_OF_SERVICE_URL=https://YOUR-PUBLIC-HOST/terms

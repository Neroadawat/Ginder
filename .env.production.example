# Copy to .env.production and replace every value marked CHANGE_ME.
# Passwords embedded in DATABASE_URL/REDIS_URL must be URL-encoded.
DOMAIN=api.example.com
PUBLIC_BASE_URL=https://api.example.com
SUPPORT_EMAIL=
WEB_CONCURRENCY=2

POSTGRES_DB=ginder
POSTGRES_USER=ginder
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

APP_NAME=Ginder
APP_ENV=production
DEBUG=false
EXPOSE_API_DOCS=false
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=ginder-api
JWT_AUDIENCE=ginder-app

RESTAURANT_DATA_MODE=production
RESTAURANT_FALLBACK_PROVIDER=osm
RESTAURANT_FALLBACK_CACHE_HOURS=168
RESTAURANT_FALLBACK_TIMEOUT_SECONDS=40
MAX_DECK_SIZE=20
MIN_LOCAL_RESTAURANTS=10
MIN_RADIUS_KM=0.5
MAX_RADIUS_KM=3.0
APP_TIMEZONE=Asia/Bangkok

CORS_ORIGINS=["https://example.com"]
ALLOWED_HOSTS=["api.example.com"]

GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_TIMEOUT_SECONDS=8
GOOGLE_NEARBY_SOFT_LIMIT=800
GOOGLE_NEARBY_HARD_LIMIT=1000
# Google Photos are disabled by the metadata-only discovery service.
GOOGLE_PHOTO_SOFT_LIMIT=0
GOOGLE_PHOTO_HARD_LIMIT=0
GOOGLE_USER_COOLDOWN_SECONDS=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_WINDOW_SECONDS=900
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=/run/secrets/firebase-credentials.json

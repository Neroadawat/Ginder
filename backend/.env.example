# ─── Database ───
DATABASE_URL=postgresql+asyncpg://ginder:ginder_secret@localhost:5432/ginder

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Auth ───
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Email (Password Reset) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ginder.app

# ─── Firebase Cloud Messaging ───
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# ─── Restaurant Data API ───
RESTAURANT_API_PROVIDER=dummy
RESTAURANT_API_KEY=
RESTAURANT_API_BASE_URL=

# ─── App Settings ───
APP_NAME=Ginder
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:8081"]

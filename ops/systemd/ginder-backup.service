[Unit]
Description=Ginder encrypted PostgreSQL backup
After=docker.service network-online.target
Requires=docker.service
OnFailure=ginder-monitor.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Ginder
ExecStart=/bin/bash /home/ubuntu/Ginder/ops/backup-postgres.sh
UMask=0077
Nice=10
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/Ginder/backups /home/ubuntu/.local/state/ginder-ops /home/ubuntu/.config/ginder-ops/gnupg

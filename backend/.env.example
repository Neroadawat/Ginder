# ─── Database ───
DATABASE_URL=postgresql+asyncpg://ginder:ginder_secret@localhost:5432/ginder

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Auth ───
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Email (Password Reset) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ginder.app

# ─── Firebase Cloud Messaging ───
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# ─── Restaurant Data API ───
RESTAURANT_API_PROVIDER=dummy
RESTAURANT_API_KEY=
RESTAURANT_API_BASE_URL=
# Use only OSM/manual records for new decks; use development for mock UI data.
RESTAURANT_DATA_MODE=production
# Outside the preloaded area: "osm" fetches once per nearby grid cell and
# caches the result for 7 days; "none" keeps the app fully local/offline.
RESTAURANT_FALLBACK_PROVIDER=osm
RESTAURANT_FALLBACK_CACHE_HOURS=168
RESTAURANT_FALLBACK_TIMEOUT_SECONDS=40
OSM_OVERPASS_PRIMARY_URL=https://overpass.private.coffee/api/interpreter
OSM_OVERPASS_SECONDARY_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSM_OVERPASS_TERTIARY_URL=https://overpass-api.de/api/interpreter

# ─── Deck coverage ───
MAX_DECK_SIZE=20
MIN_LOCAL_RESTAURANTS=10

# ─── App Settings ───
APP_NAME=Ginder
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:8081"]

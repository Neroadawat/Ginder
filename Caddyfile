{$DOMAIN} {
    encode zstd gzip
    @restaurant_photo {
        method POST
        path_regexp restaurant_photo ^/admin/api/restaurants/[0-9a-fA-F-]{36}/photo$
    }
    handle @restaurant_photo {
        request_body {
            max_size 6MB
        }
        reverse_proxy backend:8000
    }
    handle {
        request_body {
            max_size 64KB
        }
        reverse_proxy backend:8000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
}
